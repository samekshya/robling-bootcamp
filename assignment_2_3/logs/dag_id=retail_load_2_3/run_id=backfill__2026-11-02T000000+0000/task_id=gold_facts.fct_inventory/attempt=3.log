{"timestamp":"2026-11-20T11:09:20.000814Z","level":"info","event":"Running statement: CREATE OR REPLACE TEMPORARY TABLE SILVER.TMP_INV_OPEN AS\nSELECT f.INV_KY, i.ITEM_ID, l.LOCN_ID AS STORE_ID, f.ITEM_KY, f.LOCN_KY,\n       f.ONHAND_QTY, f.EFF_START_DT\nFROM RETAIL_DW.FCT_INVENTORY f\nJOIN RETAIL_DW.DIM_ITEM i ON i.ITEM_KY = f.ITEM_KY\nJOIN RETAIL_DW.DIM_LOCN l ON l.LOCN_KY = f.LOCN_KY\nWHERE f.EFF_END_DT = DATE '9999-12-31';, parameters: None","ti_id":"01a1f8a4-2769-7b0e-9302-6ad385d802b5","try_number":3,"task_id":"gold_facts.fct_inventory","run_id":"backfill__2026-11-02T00:00:00+00:00","dag_id":"retail_load_2_3","map_index":-1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
