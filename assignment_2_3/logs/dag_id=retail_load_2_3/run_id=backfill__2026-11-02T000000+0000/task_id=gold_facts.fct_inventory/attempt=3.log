{"timestamp":"2026-11-20T11:09:21.580928Z","level":"info","event":"Running statement: INSERT INTO RETAIL_DW.FCT_INVENTORY (ITEM_KY, LOCN_KY, EFF_START_DT, EFF_END_DT,\n                                     ONHAND_QTY, INV_VALUE_AMT, CURRENCY_CD)\nSELECT s.ITEM_KY, s.LOCN_KY, TO_DATE('2026-11-02'), DATE '9999-12-31',\n       s.ONHAND_QTY, s.INV_VALUE_AMT, s.CURRENCY_CD\nFROM SILVER.TMP_INV_SRC s\nCROSS JOIN SILVER.TMP_INV_GUARD g\nWHERE g.IS_LATEST\n  AND NOT EXISTS (\n        SELECT 1\n        FROM RETAIL_DW.FCT_INVENTORY f\n        JOIN RETAIL_DW.DIM_ITEM i ON i.ITEM_KY = f.ITEM_KY\n        JOIN RETAIL_DW.DIM_LOCN l ON l.LOCN_KY = f.LOCN_KY\n        WHERE f.EFF_END_DT = DATE '9999-12-31'\n          AND i.ITEM_ID = s.ITEM_ID\n          AND l.LOCN_ID = s.STORE_ID);, parameters: None","ti_id":"01a1f8a4-2769-7b0e-9302-6ad385d802b5","try_number":3,"task_id":"gold_facts.fct_inventory","run_id":"backfill__2026-11-02T00:00:00+00:00","dag_id":"retail_load_2_3","map_index":-1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
