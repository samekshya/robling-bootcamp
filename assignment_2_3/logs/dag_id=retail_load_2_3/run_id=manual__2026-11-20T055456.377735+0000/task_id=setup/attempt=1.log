{"timestamp":"2026-11-20T07:51:24.707396Z","level":"info","event":"Running statement: -- ---------------------------------------------------------------------\n-- Stage and file format: where files are uploaded (PUT) and how they\n-- are read. Values are kept exactly as sent: no trimming, empty fields\n-- stay empty strings, so Silver can see and count every defect.\n-- ---------------------------------------------------------------------\nCREATE FILE FORMAT IF NOT EXISTS BRONZE.CSV_RAW\n    TYPE = CSV\n    SKIP_HEADER = 1\n    FIELD_OPTIONALLY_ENCLOSED_BY = '\"'\n    EMPTY_FIELD_AS_NULL = FALSE\n    TRIM_SPACE = FALSE\n    ENCODING = 'UTF8';, parameters: None","task_id":"setup","dag_id":"retail_load_2_3","map_index":-1,"ti_id":"01a1f785-b138-7287-b68e-407abb64f0de","try_number":1,"run_id":"manual__2026-11-20T05:54:56.377735+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
