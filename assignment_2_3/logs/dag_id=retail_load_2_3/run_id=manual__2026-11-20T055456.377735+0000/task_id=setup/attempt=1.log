{"timestamp":"2026-11-20T07:51:26.827180Z","level":"info","event":"Running statement: -- ---------------------------------------------------------------------\n-- GOLD reserved member: every sale points to the Unknown customer,\n-- because the source has no customer feed. MERGE keeps it to one row.\n-- ---------------------------------------------------------------------\nMERGE INTO RETAIL_DW.DIM_CUSTOMER t\nUSING (SELECT -1 AS CUSTOMER_KY, 0 AS CUSTOMER_ID,\n              'Unknown customer' AS CUSTOMER_NM, FALSE AS LOYALTY_FLG) s\n   ON t.CUSTOMER_KY = s.CUSTOMER_KY\nWHEN NOT MATCHED THEN\n    INSERT (CUSTOMER_KY, CUSTOMER_ID, CUSTOMER_NM, LOYALTY_FLG)\n    VALUES (s.CUSTOMER_KY, s.CUSTOMER_ID, s.CUSTOMER_NM, s.LOYALTY_FLG);, parameters: None","task_id":"setup","dag_id":"retail_load_2_3","map_index":-1,"ti_id":"01a1f785-b138-7287-b68e-407abb64f0de","try_number":1,"run_id":"manual__2026-11-20T05:54:56.377735+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
