{"timestamp":"2026-11-20T05:55:13.221081Z","level":"info","event":"Running statement: -- ---------------------------------------------------------------------\n-- GOLD reserved member: every sale points to the Unknown customer,\n-- because the source has no customer feed. MERGE keeps it to one row.\n-- ---------------------------------------------------------------------\nMERGE INTO RETAIL_DW.DIM_CUSTOMER t\nUSING (SELECT -1 AS CUSTOMER_KY, 0 AS CUSTOMER_ID,\n              'Unknown customer' AS CUSTOMER_NM, FALSE AS LOYALTY_FLG) s\n   ON t.CUSTOMER_KY = s.CUSTOMER_KY\nWHEN NOT MATCHED THEN\n    INSERT (CUSTOMER_KY, CUSTOMER_ID, CUSTOMER_NM, LOYALTY_FLG)\n    VALUES (s.CUSTOMER_KY, s.CUSTOMER_ID, s.CUSTOMER_NM, s.LOYALTY_FLG);, parameters: None","try_number":1,"task_id":"setup","ti_id":"01a1f785-b291-7773-9dc7-18e189cd74cc","run_id":"scheduled__2026-11-20T00:00:00+00:00","map_index":-1,"dag_id":"retail_load_2_3","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
