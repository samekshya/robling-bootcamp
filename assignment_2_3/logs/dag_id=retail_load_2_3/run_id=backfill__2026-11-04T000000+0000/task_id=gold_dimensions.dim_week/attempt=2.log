{"timestamp":"2026-11-20T11:10:38.145558Z","level":"info","event":"Running statement: MERGE INTO RETAIL_DW.DIM_WEEK t\nUSING (\n    SELECT DISTINCT\n        f.FISCAL_YEAR * 100 + f.WEEK_NUM AS WEEK_ID,\n        f.WEEK_NUM,\n        f.WEEK_START_DT,\n        f.WEEK_END_DT,\n        y.YEAR_KY\n    FROM SILVER.SLV_FISCAL_DAY f\n    JOIN RETAIL_DW.DIM_YEAR y ON y.YEAR_ID = f.FISCAL_YEAR\n) s\n   ON t.WEEK_ID = s.WEEK_ID\nWHEN MATCHED AND (t.WEEK_START_DT <> s.WEEK_START_DT OR t.WEEK_END_DT <> s.WEEK_END_DT\n                  OR t.YEAR_KY <> s.YEAR_KY) THEN\n    UPDATE SET WEEK_NUM = s.WEEK_NUM, WEEK_START_DT = s.WEEK_START_DT,\n               WEEK_END_DT = s.WEEK_END_DT, YEAR_KY = s.YEAR_KY,\n               UPDATE_TS = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN\n    INSERT (WEEK_ID, WEEK_NUM, WEEK_START_DT, WEEK_END_DT, YEAR_KY)\n    VALUES (s.WEEK_ID, s.WEEK_NUM, s.WEEK_START_DT, s.WEEK_END_DT, s.YEAR_KY);, parameters: None","run_id":"backfill__2026-11-04T00:00:00+00:00","dag_id":"retail_load_2_3","map_index":-1,"task_id":"gold_dimensions.dim_week","try_number":2,"ti_id":"01a1f8a4-28e7-77ba-98a0-3b4db32bcc31","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
