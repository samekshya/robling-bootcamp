{"timestamp":"2026-11-20T10:39:08.681629Z","level":"info","event":"Running statement: MERGE INTO RETAIL_DW.DIM_SUBCATG t\nUSING (\n    SELECT src.SUBCATG_ID, src.SUBCATG_NM, c.CATG_KY, g.IS_LATEST\n    FROM (\n        SELECT SUBCLASS_ID AS SUBCATG_ID, SUBCLASS_NAME AS SUBCATG_NM, DEPT_ID\n        FROM SILVER.SLV_ITEM\n        WHERE BUSINESS_DATE = TO_DATE('2026-11-04')\n        QUALIFY ROW_NUMBER() OVER (PARTITION BY SUBCLASS_ID ORDER BY SUBCLASS_NAME) = 1\n    ) src\n    JOIN RETAIL_DW.DIM_CATG c ON c.CATG_ID = src.DEPT_ID\n    CROSS JOIN (\n        SELECT TO_DATE('2026-11-04') >= COALESCE(MAX(BUSINESS_DATE), TO_DATE('1900-01-01')) AS IS_LATEST\n        FROM SILVER.AUD_RECONCILIATION\n    ) g\n) s\n   ON t.SUBCATG_ID = s.SUBCATG_ID\nWHEN MATCHED AND s.IS_LATEST AND (t.SUBCATG_NM <> s.SUBCATG_NM OR t.CATG_KY <> s.CATG_KY) THEN\n    UPDATE SET SUBCATG_NM = s.SUBCATG_NM, CATG_KY = s.CATG_KY, UPDATE_TS = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN\n    INSERT (SUBCATG_ID, SUBCATG_NM, CATG_KY) VALUES (s.SUBCATG_ID, s.SUBCATG_NM, s.CATG_KY);, parameters: None","run_id":"backfill__2026-11-04T00:00:00+00:00","dag_id":"retail_load_2_3","map_index":-1,"task_id":"gold_dimensions.dim_subcatg","try_number":1,"ti_id":"01a1f882-0de9-7bfd-abe0-a9cad1508ee8","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
