{"timestamp":"2026-11-20T10:31:17.250040Z","level":"info","event":"Running statement: INSERT INTO RETAIL_DW.FCT_SALES (TXN_ID, TXN_LINE_ID, ITEM_KY, LOCN_KY, DAY_KY, CUSTOMER_KY,\n                                 SLS_QTY, UNIT_PRICE_AMT, SLS_AMT, CURRENCY_CD)\nSELECT s.TXN_ID, s.TXN_LINE_ID, i.ITEM_KY, l.LOCN_KY, d.DAY_KY, -1,\n       s.SLS_QTY, s.UNIT_PRICE_AMT, s.SLS_AMT, s.CURRENCY_CD\nFROM SILVER.SLV_SALES_LINE s\nJOIN RETAIL_DW.DIM_DAY  d ON d.FULL_DT = s.BUSINESS_DATE\nJOIN RETAIL_DW.DIM_ITEM i ON i.ITEM_ID = s.ITEM_ID\n                         AND s.BUSINESS_DATE BETWEEN i.EFF_START_DT AND i.EFF_END_DT\nJOIN RETAIL_DW.DIM_LOCN l ON l.LOCN_ID = s.STORE_ID\n                         AND s.BUSINESS_DATE BETWEEN l.EFF_START_DT AND l.EFF_END_DT\nWHERE s.BUSINESS_DATE = TO_DATE('2026-11-01');, parameters: None","try_number":1,"task_id":"gold_facts.fct_sales","ti_id":"01a1f882-0d3f-7a7b-b6ca-a9c2a3e7fd23","dag_id":"retail_load_2_3","map_index":-1,"run_id":"backfill__2026-11-01T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
