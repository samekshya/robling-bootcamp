{"timestamp":"2026-11-20T11:08:31.480633Z","level":"info","event":"Running statement: CREATE OR REPLACE TEMPORARY TABLE SILVER.TMP_INV_SRC AS\nSELECT p.ITEM_ID, p.STORE_ID, i.ITEM_KY, l.LOCN_KY, p.ONHAND_QTY,\n       ROUND(p.ONHAND_QTY * p.UNIT_COST, 2) AS INV_VALUE_AMT,\n       st.CURRENCY_CD\nFROM SILVER.SLV_INVENTORY_POSITION p\nJOIN RETAIL_DW.DIM_ITEM i ON i.ITEM_ID = p.ITEM_ID\n                         AND p.BUSINESS_DATE BETWEEN i.EFF_START_DT AND i.EFF_END_DT\nJOIN RETAIL_DW.DIM_LOCN l ON l.LOCN_ID = p.STORE_ID\n                         AND p.BUSINESS_DATE BETWEEN l.EFF_START_DT AND l.EFF_END_DT\nJOIN SILVER.SLV_STORE st ON st.STORE_ID = p.STORE_ID AND st.BUSINESS_DATE = p.BUSINESS_DATE\nWHERE p.BUSINESS_DATE = TO_DATE('2026-11-01');, parameters: None","try_number":2,"task_id":"gold_facts.fct_inventory","map_index":-1,"ti_id":"01a1f8a4-258d-75f8-8d26-a69a5623c4d0","run_id":"backfill__2026-11-01T00:00:00+00:00","dag_id":"retail_load_2_3","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
