{"timestamp":"2026-11-20T11:08:32.155862Z","level":"info","event":"Running statement: CREATE OR REPLACE TEMPORARY TABLE SILVER.TMP_INV_OPEN AS\nSELECT f.INV_KY, i.ITEM_ID, l.LOCN_ID AS STORE_ID, f.ITEM_KY, f.LOCN_KY,\n       f.ONHAND_QTY, f.EFF_START_DT\nFROM RETAIL_DW.FCT_INVENTORY f\nJOIN RETAIL_DW.DIM_ITEM i ON i.ITEM_KY = f.ITEM_KY\nJOIN RETAIL_DW.DIM_LOCN l ON l.LOCN_KY = f.LOCN_KY\nWHERE f.EFF_END_DT = DATE '9999-12-31';, parameters: None","try_number":2,"task_id":"gold_facts.fct_inventory","map_index":-1,"ti_id":"01a1f8a4-258d-75f8-8d26-a69a5623c4d0","run_id":"backfill__2026-11-01T00:00:00+00:00","dag_id":"retail_load_2_3","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
