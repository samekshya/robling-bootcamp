{"timestamp":"2026-11-20T11:08:32.839830Z","level":"info","event":"Running statement: UPDATE RETAIL_DW.FCT_INVENTORY f\n   SET EFF_END_DT = DATEADD(day, -1, TO_DATE('2026-11-01')),\n       UPDATE_TS  = CURRENT_TIMESTAMP()\n  FROM (\n        SELECT o.INV_KY\n        FROM SILVER.TMP_INV_OPEN o\n        LEFT JOIN SILVER.TMP_INV_SRC s\n               ON s.ITEM_ID = o.ITEM_ID AND s.STORE_ID = o.STORE_ID\n        WHERE o.EFF_START_DT < TO_DATE('2026-11-01')\n          AND (s.ITEM_ID IS NULL\n               OR s.ONHAND_QTY <> o.ONHAND_QTY\n               OR s.ITEM_KY    <> o.ITEM_KY\n               OR s.LOCN_KY    <> o.LOCN_KY)\n       ) c,\n       SILVER.TMP_INV_GUARD g\n WHERE f.INV_KY = c.INV_KY\n   AND g.IS_LATEST;, parameters: None","try_number":2,"task_id":"gold_facts.fct_inventory","map_index":-1,"ti_id":"01a1f8a4-258d-75f8-8d26-a69a5623c4d0","run_id":"backfill__2026-11-01T00:00:00+00:00","dag_id":"retail_load_2_3","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
