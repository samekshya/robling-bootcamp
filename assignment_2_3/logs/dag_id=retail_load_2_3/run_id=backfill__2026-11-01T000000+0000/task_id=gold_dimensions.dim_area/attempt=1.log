{"timestamp":"2026-11-20T10:30:58.296661Z","level":"info","event":"Running statement: MERGE INTO RETAIL_DW.DIM_AREA t\nUSING (\n    SELECT src.*, g.IS_LATEST\n    FROM (\n        SELECT AREA_ID, AREA_NAME AS AREA_NM\n        FROM SILVER.SLV_STORE\n        WHERE BUSINESS_DATE = TO_DATE('2026-11-01')\n        QUALIFY ROW_NUMBER() OVER (PARTITION BY AREA_ID ORDER BY AREA_NAME) = 1\n    ) src\n    CROSS JOIN (\n        SELECT TO_DATE('2026-11-01') >= COALESCE(MAX(BUSINESS_DATE), TO_DATE('1900-01-01')) AS IS_LATEST\n        FROM SILVER.AUD_RECONCILIATION\n    ) g\n) s\n   ON t.AREA_ID = s.AREA_ID\nWHEN MATCHED AND s.IS_LATEST AND t.AREA_NM <> s.AREA_NM THEN\n    UPDATE SET AREA_NM = s.AREA_NM, UPDATE_TS = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN\n    INSERT (AREA_ID, AREA_NM) VALUES (s.AREA_ID, s.AREA_NM);, parameters: None","map_index":-1,"run_id":"backfill__2026-11-01T00:00:00+00:00","ti_id":"01a1f882-0d3b-7f3b-9ac5-c7864a61b6d9","dag_id":"retail_load_2_3","try_number":1,"task_id":"gold_dimensions.dim_area","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
