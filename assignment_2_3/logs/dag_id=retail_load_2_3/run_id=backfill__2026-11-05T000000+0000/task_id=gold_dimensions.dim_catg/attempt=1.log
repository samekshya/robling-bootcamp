{"timestamp":"2026-11-20T10:40:01.079790Z","level":"info","event":"Running statement: MERGE INTO RETAIL_DW.DIM_CATG t\nUSING (\n    SELECT src.*, g.IS_LATEST\n    FROM (\n        SELECT DEPT_ID AS CATG_ID, DEPT_NAME AS CATG_NM\n        FROM SILVER.SLV_ITEM\n        WHERE BUSINESS_DATE = TO_DATE('2026-11-05')\n        QUALIFY ROW_NUMBER() OVER (PARTITION BY DEPT_ID ORDER BY DEPT_NAME) = 1\n    ) src\n    CROSS JOIN (\n        SELECT TO_DATE('2026-11-05') >= COALESCE(MAX(BUSINESS_DATE), TO_DATE('1900-01-01')) AS IS_LATEST\n        FROM SILVER.AUD_RECONCILIATION\n    ) g\n) s\n   ON t.CATG_ID = s.CATG_ID\nWHEN MATCHED AND s.IS_LATEST AND t.CATG_NM <> s.CATG_NM THEN\n    UPDATE SET CATG_NM = s.CATG_NM, UPDATE_TS = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN\n    INSERT (CATG_ID, CATG_NM) VALUES (s.CATG_ID, s.CATG_NM);, parameters: None","map_index":-1,"run_id":"backfill__2026-11-05T00:00:00+00:00","ti_id":"01a1f882-0e20-78ab-ba0c-a6985c1bff04","dag_id":"retail_load_2_3","try_number":1,"task_id":"gold_dimensions.dim_catg","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
