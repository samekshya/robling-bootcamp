{"timestamp":"2026-11-20T10:40:01.308356Z","level":"info","event":"Running statement: MERGE INTO RETAIL_DW.DIM_AREA t\nUSING (\n    SELECT src.*, g.IS_LATEST\n    FROM (\n        SELECT AREA_ID, AREA_NAME AS AREA_NM\n        FROM SILVER.SLV_STORE\n        WHERE BUSINESS_DATE = TO_DATE('2026-11-05')\n        QUALIFY ROW_NUMBER() OVER (PARTITION BY AREA_ID ORDER BY AREA_NAME) = 1\n    ) src\n    CROSS JOIN (\n        SELECT TO_DATE('2026-11-05') >= COALESCE(MAX(BUSINESS_DATE), TO_DATE('1900-01-01')) AS IS_LATEST\n        FROM SILVER.AUD_RECONCILIATION\n    ) g\n) s\n   ON t.AREA_ID = s.AREA_ID\nWHEN MATCHED AND s.IS_LATEST AND t.AREA_NM <> s.AREA_NM THEN\n    UPDATE SET AREA_NM = s.AREA_NM, UPDATE_TS = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN\n    INSERT (AREA_ID, AREA_NM) VALUES (s.AREA_ID, s.AREA_NM);, parameters: None","dag_id":"retail_load_2_3","try_number":1,"task_id":"gold_dimensions.dim_area","ti_id":"01a1f882-0e23-7eef-aa6f-36b9f00403e4","run_id":"backfill__2026-11-05T00:00:00+00:00","map_index":-1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
