{"timestamp":"2026-11-20T10:38:21.834087Z","level":"info","event":"Running statement: MERGE INTO RETAIL_DW.DIM_DISTRICT t\nUSING (\n    SELECT src.DISTRICT_ID, src.DISTRICT_NM, r.REGN_KY, g.IS_LATEST\n    FROM (\n        SELECT DISTRICT_ID, DISTRICT_NAME AS DISTRICT_NM, REGION_ID\n        FROM SILVER.SLV_STORE\n        WHERE BUSINESS_DATE = TO_DATE('2026-11-03')\n        QUALIFY ROW_NUMBER() OVER (PARTITION BY DISTRICT_ID ORDER BY DISTRICT_NAME, STORE_ID) = 1\n    ) src\n    JOIN RETAIL_DW.DIM_REGN r ON r.REGN_ID = src.REGION_ID\n    CROSS JOIN (\n        SELECT TO_DATE('2026-11-03') >= COALESCE(MAX(BUSINESS_DATE), TO_DATE('1900-01-01')) AS IS_LATEST\n        FROM SILVER.AUD_RECONCILIATION\n    ) g\n) s\n   ON t.DISTRICT_ID = s.DISTRICT_ID\nWHEN MATCHED AND s.IS_LATEST AND (t.DISTRICT_NM <> s.DISTRICT_NM OR t.REGN_KY <> s.REGN_KY) THEN\n    UPDATE SET DISTRICT_NM = s.DISTRICT_NM, REGN_KY = s.REGN_KY, UPDATE_TS = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN\n    INSERT (DISTRICT_ID, DISTRICT_NM, REGN_KY) VALUES (s.DISTRICT_ID, s.DISTRICT_NM, s.REGN_KY);, parameters: None","try_number":1,"task_id":"gold_dimensions.dim_district","ti_id":"01a1f882-0db5-7613-abee-ec1f6bc4ba53","map_index":-1,"run_id":"backfill__2026-11-03T00:00:00+00:00","dag_id":"retail_load_2_3","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
