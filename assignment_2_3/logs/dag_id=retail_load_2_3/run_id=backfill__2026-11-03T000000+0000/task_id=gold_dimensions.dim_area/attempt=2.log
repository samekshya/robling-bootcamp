{"timestamp":"2026-11-20T11:09:49.452545Z","level":"info","event":"Running statement: MERGE INTO RETAIL_DW.DIM_AREA t\nUSING (\n    SELECT src.*, g.IS_LATEST\n    FROM (\n        SELECT AREA_ID, AREA_NAME AS AREA_NM\n        FROM SILVER.SLV_STORE\n        WHERE BUSINESS_DATE = TO_DATE('2026-11-03')\n        QUALIFY ROW_NUMBER() OVER (PARTITION BY AREA_ID ORDER BY AREA_NAME) = 1\n    ) src\n    CROSS JOIN (\n        SELECT TO_DATE('2026-11-03') >= COALESCE(MAX(BUSINESS_DATE), TO_DATE('1900-01-01')) AS IS_LATEST\n        FROM SILVER.AUD_RECONCILIATION\n    ) g\n) s\n   ON t.AREA_ID = s.AREA_ID\nWHEN MATCHED AND s.IS_LATEST AND t.AREA_NM <> s.AREA_NM THEN\n    UPDATE SET AREA_NM = s.AREA_NM, UPDATE_TS = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN\n    INSERT (AREA_ID, AREA_NM) VALUES (s.AREA_ID, s.AREA_NM);, parameters: None","try_number":2,"task_id":"gold_dimensions.dim_area","map_index":-1,"ti_id":"01a1f8a4-2840-79a6-b53a-3f7c8092356b","run_id":"backfill__2026-11-03T00:00:00+00:00","dag_id":"retail_load_2_3","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
