        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    DIM_CATG ||--o{ DIM_SUBCATG : groups\n    DIM_SUBCATG ||--o{ DIM_ITEM : classifies\n    DIM_AREA ||--o{ DIM_REGN : contains\n    DIM_REGN ||--o{ DIM_DISTRICT : contains\n    DIM_DISTRICT ||--o{ DIM_LOCN : contains\n    DIM_YEAR ||--o{ DIM_MONTH : contains\n    DIM_YEAR ||--o{ DIM_WEEK : contains\n    DIM_MONTH ||--o{ DIM_DAY : contains\n    DIM_WEEK ||--o{ DIM_DAY : contains\n    DIM_ITEM ||--o{ FCT_SALES : sold_as\n    DIM_LOCN ||--o{ FCT_SALES : sold_at\n    DIM_DAY ||--o{ FCT_SALES : sold_on\n    DIM_CUSTOMER ||--o{ FCT_SALES : bought_by\n    DIM_ITEM ||--o{ FCT_INVENTORY : stocked_as\n    DIM_LOCN ||--o{ FCT_INVENTORY : stocked_at\n    DIM_ITEM ||--o{ FCT_PRICE : priced\n    DIM_LOCN ||--o{ FCT_PRICE : priced_at\n    DIM_DAY ||--o{ FCT_PRICE : priced_from\n\n    DIM_CATG {\n        int CATG_KY PK \&quot;surrogate key\&quot;\n        int CATG_ID UK \&quot;business key (RMS dept)\&quot;\n        string CATG_NM \&quot;SCD1\&quot;\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }\n    DIM_SUBCATG {\n        int SUBCATG_KY PK \&quot;surrogate key\&quot;\n        int SUBCATG_ID UK \&quot;business key (RMS subclass)\&quot;\n        string SUBCATG_NM \&quot;SCD1\&quot;\n        int CATG_KY FK \&quot;SCD1\&quot;\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }\n    DIM_ITEM {\n        int ITEM_KY PK \&quot;surrogate key\&quot;\n        int ITEM_ID \&quot;business key\&quot;\n        string ITEM_NM \&quot;SCD1\&quot;\n        string BRAND_NM \&quot;SCD2\&quot;\n        int SUBCATG_KY FK \&quot;SCD2\&quot;\n        boolean CURR_FLG\n        date EFF_START_DT\n        date EFF_END_DT\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }\n    DIM_AREA {\n        int AREA_KY PK \&quot;surrogate key\&quot;\n        int AREA_ID UK \&quot;business key\&quot;\n        string AREA_NM \&quot;SCD1\&quot;\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }\n    DIM_REGN {\n        int REGN_KY PK \&quot;surrogate key\&quot;\n        int REGN_ID UK \&quot;business key\&quot;\n        string REGN_NM \&quot;SCD1\&quot;\n        string COUNTRY_NM \&quot;SCD1\&quot;\n        int AREA_KY FK \&quot;SCD1\&quot;\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }\n    DIM_DISTRICT {\n        int DISTRICT_KY PK \&quot;surrogate key\&quot;\n        int DISTRICT_ID UK \&quot;business key\&quot;\n        string DISTRICT_NM \&quot;SCD1\&quot;\n        int REGN_KY FK \&quot;SCD1\&quot;\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }\n    DIM_LOCN {\n        int LOCN_KY PK \&quot;surrogate key\&quot;\n        int LOCN_ID \&quot;business key\&quot;\n        string LOCN_NM \&quot;SCD1\&quot;\n        string LOCN_TYPE_CD \&quot;S store, W warehouse, E web\&quot;\n        int DISTRICT_KY FK \&quot;SCD2\&quot;\n        boolean CURR_FLG\n        date EFF_START_DT\n        date EFF_END_DT\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }\n    DIM_YEAR {\n        int YEAR_KY PK \&quot;surrogate key\&quot;\n        int YEAR_ID UK \&quot;fiscal year\&quot;\n        date YEAR_START_DT \&quot;SCD1\&quot;\n        date YEAR_END_DT \&quot;SCD1\&quot;\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }\n    DIM_MONTH {\n        int MONTH_KY PK \&quot;surrogate key\&quot;\n        int MONTH_ID UK \&quot;fiscal period\&quot;\n        int MONTH_NUM \&quot;SCD1\&quot;\n        string MONTH_NM \&quot;SCD1\&quot;\n        int WEEKS_IN_MONTH_NUM \&quot;4 or 5\&quot;\n        date MONTH_START_DT \&quot;SCD1\&quot;\n        date MONTH_END_DT \&quot;SCD1\&quot;\n        int YEAR_KY FK \&quot;SCD1\&quot;\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }\n    DIM_WEEK {\n        int WEEK_KY PK \&quot;surrogate key\&quot;\n        int WEEK_ID UK \&quot;fiscal week, Sun-Sat\&quot;\n        int WEEK_NUM \&quot;SCD1\&quot;\n        date WEEK_START_DT \&quot;SCD1\&quot;\n        date WEEK_END_DT \&quot;SCD1\&quot;\n        int YEAR_KY FK \&quot;SCD1\&quot;\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }\n    DIM_DAY {\n        int DAY_KY PK \&quot;surrogate key\&quot;\n        int DAY_ID UK \&quot;business key\&quot;\n        date FULL_DT \&quot;SCD1\&quot;\n        int DAY_NUM \&quot;SCD1\&quot;\n        string HOLIDAY_NM \&quot;SCD1\&quot;\n        int WEEK_KY FK \&quot;SCD1\&quot;\n        int MONTH_KY FK \&quot;SCD1\&quot;\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }\n    DIM_CUSTOMER {\n        int CUSTOMER_KY PK \&quot;surrogate key\&quot;\n        int CUSTOMER_ID UK \&quot;business key\&quot;\n        string CUSTOMER_NM \&quot;SCD1\&quot;\n        boolean LOYALTY_FLG \&quot;SCD1\&quot;\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }\n    FCT_SALES {\n        bigint SLS_LINE_KY PK \&quot;surrogate key\&quot;\n        string TXN_ID \&quot;durable key part 1\&quot;\n        int TXN_LINE_ID \&quot;durable key part 2\&quot;\n        int ITEM_KY FK\n        int LOCN_KY FK\n        int DAY_KY FK\n        int CUSTOMER_KY FK\n        int SLS_QTY\n        decimal UNIT_PRICE_AMT\n        decimal SLS_AMT\n        string CURRENCY_CD \&quot;USD or CAD\&quot;\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }\n    FCT_INVENTORY {\n        bigint INV_KY PK \&quot;surrogate key\&quot;\n        int ITEM_KY FK\n        int LOCN_KY FK\n        date EFF_START_DT\n        date EFF_END_DT\n        decimal ONHAND_QTY\n        decimal INV_VALUE_AMT\n        string CURRENCY_CD \&quot;USD or CAD\&quot;\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }\n    FCT_PRICE {\n        bigint PRICE_KY PK \&quot;surrogate key\&quot;\n        int ITEM_KY FK\n        int LOCN_KY FK\n        int DAY_KY FK\n        decimal PRICE_AMT\n        string CURRENCY_CD \&quot;USD or CAD\&quot;\n        date EFF_START_DT\n        date EFF_END_DT\n        timestamp INSERT_TS\n        timestamp UPDATE_TS\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ugUNkvKlUa4k-1mu7ER3-1">
